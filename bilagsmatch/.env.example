# SQLite database file (relative to prisma/schema.prisma). Use a Postgres URL in production.
DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL of the app.
NEXTAUTH_URL="http://localhost:3000"

# Optional. When set, documents are sent to Anthropic's API for extraction.
# When empty, the deterministic mock provider is used ("Demo-tilstand").
ANTHROPIC_API_KEY=""

# Optional. Claude model used for extraction.
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Optional. Where uploaded files are stored (default ./storage/uploads).
STORAGE_DIR="./storage/uploads"

# Optional. Set to "false" to disable the in-process extraction worker (e.g. in a separate worker setup).
EXTRACTION_WORKER_ENABLED="true"
