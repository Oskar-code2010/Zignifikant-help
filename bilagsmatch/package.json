{
  "name": "bilagsmatch",
  "version": "0.1.0",
  "private": true,
  "description": "AI receipt-to-bank matching for Danish bookkeepers",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "prisma generate --no-hints >/dev/null && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force --skip-seed && tsx prisma/seed.ts",
    "postinstall": "prisma generate --no-hints",
    "demo:check": "tsx scripts/demo-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "iconv-lite": "0.7.3",
    "lucide-react": "0.544.0",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "papaparse": "5.5.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "2.0.7",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.1.16",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "pdf-lib": "1.17.1",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.16",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": ">=20.9"
  }
}
